<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="itmr_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistemler: sensor verisi icin hepsi gerekli -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- GPS (NavSat) icin gerekli; bitirme projesinde de kullanilir -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>41.0082</latitude_deg>
      <longitude_deg>28.9784</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <atmosphere type="adiabatic">
      <temperature>300</temperature>
    </atmosphere>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Zemin -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>22.5 22.5</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>22.5 22.5</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.7 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dis duvarlar: 20x20 m ic alan, 1.5 m yukseklik -->
    <model name="outer_walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>0 7.6125 0.5625 0 0 0</pose><geometry><box><size>15.45 0.225 1.125</size></box></geometry></collision>
        <visual name="north_v"><pose>0 7.6125 0.5625 0 0 0</pose><geometry><box><size>15.45 0.225 1.125</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>

        <collision name="south_c"><pose>0 -7.6125 0.5625 0 0 0</pose><geometry><box><size>15.45 0.225 1.125</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -7.6125 0.5625 0 0 0</pose><geometry><box><size>15.45 0.225 1.125</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>

        <collision name="east_c"><pose>7.6125 0 0.5625 0 0 0</pose><geometry><box><size>0.225 15.45 1.125</size></box></geometry></collision>
        <visual name="east_v"><pose>7.6125 0 0.5625 0 0 0</pose><geometry><box><size>0.225 15.45 1.125</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>

        <collision name="west_c"><pose>-7.6125 0 0.5625 0 0 0</pose><geometry><box><size>0.225 15.45 1.125</size></box></geometry></collision>
        <visual name="west_v"><pose>-7.6125 0 0.5625 0 0 0</pose><geometry><box><size>0.225 15.45 1.125</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Gri engeller: kutular -->
    <model name="box_1">
      <static>true</static><pose>3 2.25 0.375 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.75 0.75 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.75 0.75 0.75</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static><pose>-3.75 3 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.125 1.125 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.125 1.125 0.75</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_3">
      <static>true</static><pose>4.5 -3.75 0.375 0 0 -0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.75 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.75 0.75</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Gri engeller: silindirler -->
    <model name="cylinder_1">
      <static>true</static><pose>-3 -3.75 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.375</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.375</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_2">
      <static>true</static><pose>0 5.25 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_3">
      <static>true</static><pose>-5.625 -0.75 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Ic duvar parcasi: duvar takibi ve LiDAR icin duz yuzey -->
    <model name="inner_wall">
      <static>true</static><pose>1.5 -5.625 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.75 0.15 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.75 0.15 0.75</size></box></geometry>
          <material><ambient>0.6 0.55 0.5 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Renkli hedefler: kamera icin -->
    <model name="red_sphere">
      <static>true</static><pose>5.625 3.375 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.3</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>360.0</temperature>
          </plugin></visual>
      </link>
    </model>

    <model name="blue_box">
      <static>true</static><pose>-4.875 5.625 0.225 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.45 0.45 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.45 0.45 0.45</size></box></geometry>
          <material><ambient>0 0.2 1 1</ambient><diffuse>0 0.2 1 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>320.0</temperature>
          </plugin></visual>
      </link>
    </model>

    <model name="green_cylinder">
      <static>true</static><pose>-6 -5.625 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.225</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.225</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>280.0</temperature>
          </plugin></visual>
      </link>
    </model>

  </world>
</sdf>
