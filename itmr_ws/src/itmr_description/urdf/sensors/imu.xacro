<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="itmrbot">
    <xacro:macro name="imu" params="parent">

        <!-- IMU gövdenin tam ortasında: tekerlek ekseninin üstü, yani dönme merkezi -->
        <link name="imu_link">
            <visual>
                <geometry>
                    <box size="0.03 0.03 0.01"/>
                </geometry>
                <material name="imu_green">
                    <color rgba="0.1 0.6 0.2 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="imu_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="imu_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <!-- Gazebo IMU sensörü: /imu topic'ine 100 Hz yayın yapar -->
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>100</update_rate>
                <visualize>true</visualize>
                <topic>imu</topic>
                <!-- fixed joint base_link'e birleştiği için frame adını elle veriyoruz -->
                <gz_frame_id>imu_link</gz_frame_id>
                <!-- Gürültü değerleri Bosch BMI088 datasheet'inden (tipik değerler):
                     stddev = noise density x sqrt(100 Hz)
                       jiroskop: 0.014 deg/s/sqrt(Hz) -> 2.44e-3 rad/s
                       ivme:     175 ug/sqrt(Hz)     -> 1.72e-2 m/s^2
                     bias_stddev = datasheet zero offset / 3 (± aralığı ~3 sigma kabul edildi)
                       jiroskop: 1 deg/s / 3 -> 6e-3 rad/s
                       ivme:     20 mg / 3   -> 6.5e-2 m/s^2
                     Bias her simülasyon başında bir kez rastgele seçilir, sonra sabit kalır. -->
                <imu>
                    <angular_velocity>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>2.44e-3</stddev><bias_mean>0.0</bias_mean><bias_stddev>6e-3</bias_stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>2.44e-3</stddev><bias_mean>0.0</bias_mean><bias_stddev>6e-3</bias_stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>2.44e-3</stddev><bias_mean>0.0</bias_mean><bias_stddev>6e-3</bias_stddev></noise></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.72e-2</stddev><bias_mean>0.0</bias_mean><bias_stddev>6.5e-2</bias_stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.72e-2</stddev><bias_mean>0.0</bias_mean><bias_stddev>6.5e-2</bias_stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.72e-2</stddev><bias_mean>0.0</bias_mean><bias_stddev>6.5e-2</bias_stddev></noise></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
