<?xml version="1.0"?>
<robot name="itmrbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gövde -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.216 0.255 0.318 1.0</ambient>
        <diffuse>0.216 0.255 0.318 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

<gazebo reference="wheel_left_link">
    <visual>
      <material>
        <ambient>0.09 0.09 0.09 1.0</ambient>
        <diffuse>0.09 0.09 0.09 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>1000000000000000.0</mu1>                      <!-- Birincil sürtünme katsayısı -->
    <mu2>1000000000000000.0</mu2>                      <!-- İkincil sürtünme katsayısı -->
    <kp>1000000000000.0</kp>                           <!-- Temas sertliği parametresi -->
    <kd>10.0</kd>                                      <!-- Temas sönümleme parametresi -->
    <minDepth>0.001</minDepth>                         <!-- Temas oluşmadan önceki minimum batma derinliği -->
    <maxVel>0.1</maxVel>                               <!-- Maksimum temas düzeltme hızı -->
    <fdir1>1 0 0</fdir1>                               <!-- Birincil sürtünme yönü (X ekseni) -->
  </gazebo>

  <gazebo reference="wheel_right_link">
    <visual>
      <material>
        <ambient>0.09 0.09 0.09 1.0</ambient>
        <diffuse>0.09 0.09 0.09 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <!-- Caster Wheels -->
  <gazebo reference="front_caster_link">
    <visual>
      <material>
        <ambient>0.09 0.09 0.09 1.0</ambient>
        <diffuse>0.09 0.09 0.09 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="rear_caster_link">
    <visual>
      <material>
        <ambient>0.09 0.09 0.09 1.0</ambient>
        <diffuse>0.09 0.09 0.09 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Beyaz farlar -->
  <gazebo reference="front_left_white_light_link">
    <visual>
      <material>
        <ambient>1.0 1.0 0.85 1.0</ambient>
        <diffuse>1.0 1.0 0.85 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="front_right_white_light_link">
    <visual>
      <material>
        <ambient>1.0 1.0 0.85 1.0</ambient>
        <diffuse>1.0 1.0 0.85 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Turuncu sinyaller -->
  <gazebo reference="front_left_indicator_link">
    <visual>
      <material>
        <ambient>1.0 0.4 0.0 1.0</ambient>
        <diffuse>1.0 0.4 0.0 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="front_right_indicator_link">
    <visual>
      <material>
        <ambient>1.0 0.4 0.0 1.0</ambient>
        <diffuse>1.0 0.4 0.0 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Turuncu şeritler -->
  <gazebo reference="left_accent_link">
    <visual>
      <material>
        <ambient>1.0 0.35 0.0 1.0</ambient>
        <diffuse>1.0 0.35 0.0 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="right_accent_link">
    <visual>
      <material>
        <ambient>1.0 0.35 0.0 1.0</ambient>
        <diffuse>1.0 0.35 0.0 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Ön dekoratif panel -->
  <gazebo reference="front_panel_link">
    <visual>
      <material>
        <ambient>0.035 0.045 0.06 1.0</ambient>
        <diffuse>0.035 0.045 0.06 1.0</diffuse>
        <specular>0.4 0.4 0.4 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Diferansiyel surus plugin'i: /cmd_vel (Twist) komutunu tekerlek hizlarina cevirir,
       odometri ve odom->base_footprint TF'ini yayinlar -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_radius>0.06675</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>
  </gazebo>

</robot>
