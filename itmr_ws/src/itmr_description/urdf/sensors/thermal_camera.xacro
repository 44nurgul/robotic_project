<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="itmrbot">
    <xacro:macro name="thermal_camera" params="parent">

        <link name="thermal_camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.012 0.030 0.030"/>
                </geometry>
                <material name="thermal_camera_body">
                    <color rgba="0.85 0.35 0.05 1.0"/>
                </material>
            </visual>
            <visual>
                <origin xyz="0.008 0 0" rpy="0 1.570796327 0"/>
                <geometry>
                    <cylinder radius="0.009" length="0.005"/>
                </geometry>
                <material name="thermal_camera_lens">
                    <color rgba="0.02 0.02 0.03 1.0"/>
                </material>
            </visual>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.01"/>
                <inertia ixx="1.5e-6" ixy="0.0" ixz="0.0"
                         iyy="1.0e-6" iyz="0.0"
                         izz="1.0e-6"/>
            </inertial>
        </link>

        <joint name="thermal_camera_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="thermal_camera_link"/>
            <origin xyz="0.194 0.06 0.068" rpy="0 0 0"/>
        </joint>

        <link name="thermal_camera_optical_frame"/>

        <joint name="thermal_camera_optical_joint" type="fixed">
            <parent link="thermal_camera_link"/>
            <child link="thermal_camera_optical_frame"/>
            <origin xyz="0.006 0 0" rpy="-1.570796327 0 -1.570796327"/>
        </joint>

        <gazebo reference="thermal_camera_link">
            <sensor name="thermal_camera" type="thermal">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <visualize>false</visualize>
                <topic>thermal/image_raw</topic>
                <gz_frame_id>thermal_camera_optical_frame</gz_frame_id>
                <pose>0.006 0 0 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>320</width>
                        <height>240</height>
                        <format>L8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>20.0</far>
                    </clip>
                </camera>
                <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
                    <min_temp>273.15</min_temp>
                    <max_temp>400.0</max_temp>
                    <resolution>1.6</resolution>
                </plugin>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
