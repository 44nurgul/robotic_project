<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="itmrbot">
    <xacro:macro name="camera" params="parent">
        <link name="camera_link">
            <!-- Yeşil PCB: 25 x 24 mm -->
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.001 0.025 0.024"/>
                </geometry>
                <material name="camera_pcb">
                    <color rgba="0.05 0.35 0.15 1.0"/>
                </material>
            </visual>
            <!-- Gri kutu -->
            <visual>
                <origin xyz="0.0015 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.003 0.0085 0.0085"/>
                </geometry>
                <material name="camera_body">
                    <color rgba="0.55 0.55 0.58 1.0"/>
                </material>
            </visual>
            <!-- Lens -->
            <visual>
                <origin xyz="0.004 0 0" rpy="0 1.570796327 0"/>
                <geometry>
                    <cylinder radius="0.004" length="0.002"/>
                </geometry>
                <material name="camera_lens">
                    <color rgba="0.02 0.02 0.03 1.0"/>
                </material>
            </visual>
            <inertial>
                <origin xyz="0.002 0 0" rpy="0 0 0"/>
                <mass value="0.004"/>
                <inertia ixx="4.0e-7" ixy="0.0" ixz="0.0"
                         iyy="2.04e-7" iyz="0.0"
                         izz="2.2e-7"/>
            </inertial>
        </link>

        <!-- Kamerayı gövdenin ön yüzüne, ortaya bağlar (PCB üst kenarı gövdenin üst çizgisiyle aynı hizada) -->
        <joint name="camera_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="camera_link"/>
            <origin xyz="0.1990 0 0.068" rpy="0 0 0"/>
        </joint>

        <!-- ROS kamera merkezi (Z ileri, X sağ, Y aşağı) -->
        <link name="camera_optical_frame"/>

        <joint name="camera_optical_joint" type="fixed">
            <parent link="camera_link"/>
            <child link="camera_optical_frame"/>
            <origin xyz="0.0055 0 0" rpy="-1.570796327 0 -1.570796327"/>
        </joint>

        <!-- Gazebo kamera sensörü eklentisi (RPi Camera Module 3 referans alınıştır: ~66° yatay FOV, 30 FPS) -->
        <gazebo reference="camera_link">
            <sensor name="rpicam_module3" type="camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>false</visualize>
                <topic>camera/image_raw</topic>
                <gz_frame_id>camera_optical_frame</gz_frame_id>
                <pose>0.0055 0 0 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.15</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <!--5cm - 100m arası görüntüler-->
                        <near>0.05</near>
                        <far>100.0</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
